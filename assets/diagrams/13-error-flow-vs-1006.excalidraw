   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1006 is a reserved RFC 6455 value an implementation must never put in an actual close frame: it exists only for a local API to report \"the connection ended with no handshake.\"",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1006 is a reserved RFC 6455 value an implementation must never put in an actual close frame: it exists only for a local API to report \"the connection ended with no handshake.\"",
